# Supabase（Project Settings > API Keys / Data API から取得）

# ブラウザにも露出する公開値。RLS で守られている前提の鍵。
# 新しい Supabase では "Publishable key"（sb_publishable_... ）という名前。
# 旧プロジェクトの "anon public"（eyJ... ）と役割は同じ。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RLS をバイパスする管理鍵。サーバー側でのみ使う。
# 新しい Supabase では "Secret key"（sb_secret_... ）という名前。
# 旧プロジェクトの "service_role secret" と役割は同じ。
# NEXT_PUBLIC_ を付けないこと。クライアントに渡ると全テナントのデータが漏れる。
SUPABASE_SERVICE_ROLE_KEY=

# アプリの公開 URL。Vercel にデプロイしたら本番の URL に変える。
# 現時点ではアプリ側で参照していないが、メール内リンクの生成で使う予定。
# Edge Function 側は Supabase のシークレット PUBLIC_SITE_URL を別に持つ。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
